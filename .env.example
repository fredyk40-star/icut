# Database Configuration (MySQL / TiDB Cloud)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_NAME=barbershop_db
MYSQL_USER=root
MYSQL_PASS=
MYSQL_CHARSET=utf8mb4
# Set MYSQL_SSL=1 for TiDB Cloud Serverless / public endpoints that require TLS.
# With MYSQL_SSL=1 the CA bundle is auto-detected from well-known system paths
# (Amazon Linux/Vercel, Debian/Ubuntu, Alpine, Fedora/RHEL, XAMPP) when left empty.
MYSQL_SSL=0
# Optional CA bundle path when MYSQL_SSL=1 (leave empty to auto-detect).
MYSQL_SSL_CA=

# Site Configuration
SITE_URL=http://localhost/icut

# JWT Configuration (for Vercel serverless)
JWT_SECRET=change-me-in-production-generate-with-openssl-rand-hex-32
JWT_COOKIE_NAME=icut_session
JWT_EXPIRY=86400
COOKIE_DOMAIN=

# Vercel Blob (for file uploads in serverless)
BLOB_READ_WRITE_TOKEN=

# Hidden admin entry gate
ADMIN_ENTRY_KEY=icitboss

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
PAYSTACK_ENABLED=0

# SMTP Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@icut.com
SMTP_FROM_NAME=icut
